# Copy this file to .env and fill in your values.
# .env is never committed to source control.

# Port the server listens on (default: 10000)
PORT=10000

# Three US SOCKS5 proxies for cookie-authenticated sessions.
# The server rotates across all three, never repeating the same IP back-to-back.
# Format: socks5://user:pass@host:port
PROXY_URL_1=socks5://<user>:<pass>@<us-host-1>:<port>
PROXY_URL_2=socks5://<user>:<pass>@<us-host-2>:<port>
PROXY_URL_3=socks5://<user>:<pass>@<us-host-3>:<port>

# Auto-generated on first run if not set — paste the printed value here to keep it stable
VNC_TOKEN=
ADMIN_TOKEN=
